# ==================================================
# RP Marketplace Production Environment
# Upload a filled copy to Jenkins as rpmarketplace-production-env
# Keep real values out of Git
# ==================================================

APP_ENV=production
APP_PORT=5000
MYSQL_HOST=rpmarketplace-production-mysql
MYSQL_PORT=3306
MYSQL_USER=CHANGE_ME_MYSQL_USER
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_DATABASE=CHANGE_ME_MYSQL_DATABASE
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
LEGACY_PRODUCT_OWNER_USERNAME=CHANGE_ME_LEGACY_OWNER
AI_AGENT_ENABLED=true
AI_AGENT_LOG_LEVEL=INFO
