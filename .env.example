# ==================================================
# RP Marketplace Environment Configuration
# Copy this file to .env and replace CHANGE_ME values
# Never commit the real .env file
# ==================================================

# --------------------------------------------------
# Application
# --------------------------------------------------
APP_NAME=RP Marketplace
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=5000
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
LEGACY_PRODUCT_OWNER_USERNAME=CHANGE_ME_LEGACY_OWNER

# --------------------------------------------------
# MySQL
# --------------------------------------------------
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=rpmarketplace-mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=rp_marketplace
MYSQL_USER=rpmarketplace
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD

# --------------------------------------------------
# Backend
# --------------------------------------------------
BACKEND_IMAGE=rpmarketplace-backend:latest
BACKEND_CONTAINER_NAME=rpmarketplace-backend
BACKEND_PORT=5000

# --------------------------------------------------
# Frontend
# --------------------------------------------------
FRONTEND_IMAGE=rpmarketplace-frontend:latest
FRONTEND_CONTAINER_NAME=rpmarketplace-frontend
FRONTEND_PORT=5000
BACKEND_INTERNAL_URL=http://backend:5000

# --------------------------------------------------
# Jenkins
# --------------------------------------------------
JENKINS_IMAGE=rpmarketplace-jenkins:latest
JENKINS_CONTAINER_NAME=rpmarketplace-jenkins
JENKINS_HTTP_PORT=8080
JENKINS_AGENT_PORT=50000
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=CHANGE_ME_JENKINS_PASSWORD
JENKINS_URL=http://jenkins:8080
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false
JENKINS_VOLUME_NAME=jenkins-data
DOCKER_SOCKET_GID=0
CASC_JENKINS_CONFIG=/var/jenkins_home/casc_configs/jenkins.yaml

# --------------------------------------------------
# GitHub
# --------------------------------------------------
GITHUB_USER=jackso271
GITHUB_PAT=CHANGE_ME_GITHUB_PAT
GIT_REPO_URL=https://github.com/jackso271/C270-E62H-Team3.git
GIT_BRANCH_STAGING=staging-environment
GIT_BRANCH_PRODUCTION=main

# --------------------------------------------------
# Docker Hub
# --------------------------------------------------
DOCKERHUB_USERNAME=jackdevil19
DOCKERHUB_TOKEN=CHANGE_ME_DOCKERHUB_TOKEN

# --------------------------------------------------
# SonarQube
# --------------------------------------------------
SONARQUBE_IMAGE=sonarqube:community
SONARQUBE_CONTAINER_NAME=rpmarketplace-sonarquube
SONARQUBE_PORT=9000
SONAR_HOST_URL=http://sonarqube:9000
SONAR_PROJECT_KEY=rpmarketplace
SONAR_PROJECT_NAME=RP Marketplace
SONAR_TOKEN=CHANGE_ME_SONAR_TOKEN

# --------------------------------------------------
# SonarQube PostgreSQL
# --------------------------------------------------
SONAR_DB_IMAGE=postgres:16-alpine
SONAR_DB_CONTAINER_NAME=rpmarketplace-sonar-db
SONAR_DB_NAME=sonarqube
SONAR_DB_USER=sonarqube
SONAR_DB_PASSWORD=CHANGE_ME_SONAR_DATABASE_PASSWORD

# --------------------------------------------------
# Nexus
# --------------------------------------------------
NEXUS_IMAGE=sonatype/nexus3:latest
NEXUS_CONTAINER_NAME=rpmarketplace-nexus
NEXUS_UI_PORT=8081
NEXUS_REGISTRY_PORT=8082
NEXUS_USER=admin
NEXUS_PASSWORD=CHANGE_ME_NEXUS_PASSWORD
NEXUS_URL=http://nexus:8081
NEXUS_REGISTRY=nexus:8082

# --------------------------------------------------
# Ansible
# --------------------------------------------------
ANSIBLE_IMAGE=rpmarketplace-ansible:latest
ANSIBLE_CONTAINER_NAME=rpmarketplace-ansible
ANSIBLE_HOST_KEY_CHECKING=False

# --------------------------------------------------
# AI Diagnostics Agent
# --------------------------------------------------
AI_DIAGNOSTICS_ENABLED=false
AI_PROVIDER=local
AI_DIAGNOSTICS_MAX_CHARS=12000
AI_DIAGNOSTICS_TIMEOUT=10
AI_DIAGNOSTICS_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY

# --------------------------------------------------
# Docker Compose
# --------------------------------------------------
COMPOSE_PROJECT_NAME=rpmarketplace
DOCKER_NETWORK_NAME=rpmarketplace-network
RESTART_POLICY=unless-stopped
