pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Staging Environment') {
            steps {
                withCredentials([
                    file(
                        credentialsId: 'rpmarketplace-staging-env',
                        variable: 'STAGING_ENV_FILE'
                    )
                ]) {
                    sh '''
                    cp "$STAGING_ENV_FILE" "$WORKSPACE/.env"
                    chmod 600 "$WORKSPACE/.env"
                    test -s "$WORKSPACE/.env"
                    '''
                }
            }
        }

        stage('Validate Ansible') {
            steps {
                sh '''
                ansible-playbook \
                    -i ansible/hosts \
                    ansible/deploy_staging_playbook.yaml \
                    --syntax-check
                '''
            }
        }

        stage('Deploy to Staging with Ansible') {
            steps {
                sh '''
                ansible-playbook \
                    -i ansible/hosts \
                    ansible/deploy_staging_playbook.yaml
                '''
            }
        }
    }

    post {
        success {
            echo 'Staging deployment completed successfully.'
        }

        failure {
            echo 'Staging pipeline failed.'
        }

        always {
            sh '''
            rm -f "$WORKSPACE/.env"
            '''
        }
    }
}
